# -*- coding: utf-8 -*-
"""
gui/benchmark_panel.py — Pannello 2: esecuzione benchmark (sez. 4.2).

Contiene: Avvia/Ferma, barra di avanzamento, area log testuale, campi
numero prompt / temperatura / timeout, pulsante "Calibra idle" e campo di
lettura della potenza idle calibrata. Il lavoro pesante gira in un thread;
la comunicazione con Tk avviene solo via ``after()``.

Sorgente dei Test (Modalita' di Input Universale): radiobutton con due
opzioni dinamiche — A) Dataset Esterno CSV (pulsante "Sfoglia..." per file
generati da tool esterni tipo MUDILab, colonna prompt + eventuale
ground_truth/expected_result) oppure B) Prompt Manuale: blocchi dinamici
numerati ("Test 1", "Test 2", ...) in un'area scrollabile, ognuno con due
campi espliciti Domanda + Risposta Attesa (opzionale), "+ Aggiungi Prompt"
e "✕" per rimuovere. I test NON sono mai hardcodati nel framework.
"""
from __future__ import annotations

import queue
import threading
import time
import tkinter as tk
from tkinter import ttk
from typing import List, Optional, Tuple


class BenchmarkPanel(ttk.Frame):
    """Pannello 'Esecuzione benchmark' + Log, con sotto-pannelli regolabili.

    Il log e' separato dal resto del pannello tramite un PanedWindow
    verticale: l'utente puo' trascinare il divisore per espandere o ridurre
    la console senza perderla di vista (richiesta UX).
    """

    def __init__(self, master, get_selections=None, **kw):
        super().__init__(master, **kw)
        self.get_selections = get_selections or (lambda: ([], []))
        self._stop_event = threading.Event()
        self._worker = None
        self._q: queue.Queue = queue.Queue()
        self._running = False

        # sotto-pannello superiore: controlli di esecuzione
        # sotto-pannello inferiore: console log (regolabile col drag)
        # NOTE (Tk 8.6 / Python Windows): le pane di ttk::panedwindow
        # ammettono SOLO -weight; "paneconfigure" e "-minsize" NON esistono
        # -> TclError. Il vincolo minimo viene quindi applicato con un
        # divisorio custom trascinabile (frame-stretta con bind B1-Motion)
        # che CLAMP-A la posizione alle altezze minime: nessuna sezione puo'
        # sparire o schiacciare l'altra. Nessun comando ttk::panedwindow
        # "pane" invocato: layout identico su Tcl/Tk 8.6 e 8.7+.
        MIN_TOP_H, MIN_LOG_H = 200, 72

        inner = tk.Frame(self)
        inner.pack(fill="both", expand=True)
        inner.columnconfigure(0, weight=1)
        # Il Log ha peso 0 + minsize: la griglia gli riserva SEMPRE un'altezza
        # fissa (>= 108px) qualunque sia lo spazio disponibile; i controlli in
        # alto si comprimono per primi. Il drag regola solo la parte alta.
        inner.rowconfigure(0, weight=1, minsize=150)
        inner.rowconfigure(1, weight=0)
        inner.rowconfigure(2, weight=0, minsize=108)

        # FIX: top e log_frame devono essere figli di inner, NON di self.
        # Usare grid(..., in_=inner) su widget creati con parent self fa
        # sparire i widget (pitfall Tkinter: reparenting via in_ non funziona
        # in modo affidabile su tutte le piattaforme).
        top = ttk.LabelFrame(inner, text="Esecuzione benchmark")
        log_frame = ttk.LabelFrame(inner, text="Log / Console")
        sash_log = tk.Frame(inner, height=6, bd=1, relief="raised",
                            background="#d8d8d8")
        try:
            sash_log.configure(cursor="sb_vdouble_arrow")
        except Exception:
            pass
        top.grid(row=0, column=0, sticky="nsew")
        sash_log.grid(row=1, column=0, sticky="ew")
        log_frame.grid(row=2, column=0, sticky="nsew")

        # drag: regola solo il minsize della riga alta; la riga log resta
        # weight=0 -> mantiene sempre il suo spazio naturale (>=90px)
        def _apply(pos_y):
            try:
                h_top = top.winfo_height()
                h_log = log_frame.winfo_height()
                span = max(h_top + h_log, MIN_TOP_H + MIN_LOG_H, 1)
                new_top = max(MIN_TOP_H, min(span - MIN_LOG_H, pos_y))
                inner.rowconfigure(0, weight=1, minsize=int(new_top))
            except Exception:

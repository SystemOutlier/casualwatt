async def main():
    session = causal_A.create_session()
    
    task = input("Inserisci la tua domanda causale: ")
    print(f'\n🎯 TASK: {task}\n')
    
    print("🔄 1. Traduzione in corso...")
    translation_a = (await translator.run(f"Create a dictionary following your instruction of the query: {task}", session=session)).text
    print(f"📝 Dictionary: {translation_a}\n")
    
    print("🔄 2. Classificazione in corso...")
    label_a = (await classificator.run(f"Classify the following query using your instructions: {task}", session=session)).text
    print(f"🏷️ Label: {label_a}\n")
    
    print("🔄 3. Calcolo causale in corso...")
    causal_answer_a = (await causal_A.run(
        f"Provide the precise answer to the user's task ({task}) using your TOOLS with the following parameters -> label: {label_a}, features: {translation_a}. After that give the causal explanation of this answer.", 
        session=session
    )).text
    print(f"✅ Risposta Finale:\n{causal_answer_a}\n")

    return translation_a, label_a, causal_answer_a